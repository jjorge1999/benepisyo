{
  "name": "benepisyo-site",
  "private": true,
  "scripts": {
    "prebuild": "node scripts/prepare-data.mjs",
    "build": "ng build",
    "postbuild": "node scripts/postbuild.mjs",
    "start": "node scripts/prepare-data.mjs && ng serve",
    "test": "node --test test/match.test.js test/i18n.test.js",
    "test:e2e": "python3 test/e2e.py http://localhost:8765 test-shots",
    "serve": "python3 -m http.server 8765 --directory dist/browser"
  },
  "engines": {
    "node": ">=22.22.3"
  },
  "dependencies": {
    "@angular/common": "22.2",
    "@angular/compiler": "22.2",
    "@angular/core": "22.2",
    "@angular/forms": "22.2",
    "@angular/platform-browser": "22.2",
    "@angular/platform-server": "22.2",
    "@angular/router": "22.2",
    "@angular/ssr": "^22.2.3",
    "ng-zorro-antd": "^22.1.2",
    "rxjs": "7.8",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "22.2",
    "@types/node": "^22.20.5",
    "less": "^4.9.1",
    "typescript": "6.0"
  }
}
